{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "includeFiles": [
          "api/**",
          "web/**",
          "rag/embeddings.json",
          "rag/documents/**",
          "skills/**",
          "tools/**",
          "config.py",
          "main.py",
          "system_prompt.py"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }]
}
